{
  "name": "daily-pass/service",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "nikic/fast-route": "^1.3",
    "guzzlehttp/guzzle": "^7.9",
    "monolog/monolog": "^3.7",
    "vlucas/phpdotenv": "^5.6",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "App\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "App\\Tests\\": "tests/" }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}