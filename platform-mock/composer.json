{
  "name": "daily-pass/platform-mock",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "guzzlehttp/guzzle": "^7.9",
    "monolog/monolog": "^3.7",
    "vlucas/phpdotenv": "^5.6"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "autoload": {
    "psr-4": { "Mock\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Mock\\Tests\\": "tests/" }
  }
}
